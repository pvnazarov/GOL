# Python tooling
.venv/
__pycache__/
*.pyc

# Local dev tooling (vendored Node, used only for testing/build scripts)
.tools/

# Consistency-check reports (regenerable)
reports/*.csv
reports/summaries_page/

# Drop folder for incoming books, before they are sorted into libs/
inbox/

# Raw personal library data: any zip, and any top-level folder under libs/
# (this covers eng1996/rus1996/rus2004 today and any future library folder
# automatically, without needing to edit this file) except the app code and
# the generated catalogue JSON, which ARE tracked.
libs/*.zip
libs/*/
!libs/assets/
!libs/assets/**
!libs/data/
!libs/data/**

# Book summaries for the site: rebuilt from summaries/ by build_catalog.py
libs/data/summaries/

# Summaries of books flagged for sex involving minors (TODO.md, "Content review"):
# never published; build_catalog.py's SUMMARY_SKIP_BOOKS keeps them off the site.
summaries/*/eng1996/EROTIC/johns.json
summaries/*/eng1996/EROTIC/misty.json
summaries/*/eng1996/EROTIC/platon.json
summaries/*/eng1996/EROTIC/fdt.json
summaries/*/eng1996/EROTIC/accting.json
summaries/*/rus1996/EROTIC/deflorat.json
summaries/*/rus1996/EROTIC/pansion.json
summaries/*/rus1996/EROTIC/plem.json
summaries/*/rus1996/EROTIC/inna.json
summaries/*/rus1996/EROTIC/montel.json
summaries/*/rus1996/EROTIC/10letter.json
summaries/*/rus1996/EROTIC/lesson.json
summaries/*/rus1996/EROTIC/betti.json
summaries/*/rus2004/EROTIC/10letter.json
summaries/*/rus2004/EROTIC/lesson.json
